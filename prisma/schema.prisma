generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  GUEST
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum OkrPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum OkrStatus {
  DRAFT
  ACTIVE
  AT_RISK
  COMPLETED
  ARCHIVED
}

enum MessagePriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_ACCEPTANCE
  NEEDS_CHANGES
  ACCEPTED
  DONE
}

enum BugStatus {
  NEW
  CONFIRMED
  ASSIGNED
  FIXING
  PENDING_VERIFICATION
  VERIFIED
  PENDING_RELEASE
  CLOSED
  REOPENED
  DEFERRED
  REJECTED
}

enum VersionStatus {
  PLANNING
  DEVELOPING
  TESTING
  PENDING_RELEASE
  RELEASED
  ARCHIVED
  CANCELLED
}

enum ReleaseStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

model User {
  id                        String                   @id @default(cuid())
  name                      String
  phone                     String                   @unique
  passwordHash              String
  avatarColor               String                   @default("#376ce7")
  avatarUrl                 String?
  systemRole                SystemRole               @default(MEMBER)
  projectMembers            ProjectMember[]
  teamMembers               TeamMember[]
  createdInvites            TeamInvite[]             @relation("TeamInviteCreator")
  assignedTasks             Task[]                   @relation("TaskAssignee")
  coordinatedTasks          Task[]                   @relation("TaskCoordinator")
  acceptedTasks             Task[]                   @relation("TaskAcceptor")
  createdTasks              Task[]                   @relation("TaskCreator")
  reports                   WorkReport[]
  acceptances               Acceptance[]
  apiTokens                 ApiToken[]
  apiIdempotencyRecords     ApiIdempotencyRecord[]
  auditLogs                 AuditLog[]
  feedbacks                 Feedback[]
  createdFolders            FileFolder[]             @relation("FolderCreator")
  createdFiles              FileAsset[]              @relation("FileCreator")
  uploadedVersions          FileVersion[]            @relation("VersionUploader")
  createdShares             FileShare[]              @relation("ShareCreator")
  uploadSessions            FileUploadSession[]
  requestedRequirements     Requirement[]            @relation("RequirementRequester")
  requirementParticipations RequirementParticipant[]
  ownedVersions             Version[]                @relation("VersionOwner")
  versionParticipations     VersionParticipant[]
  ownedMilestones           Milestone[]              @relation("MilestoneOwner")
  ownedTeamObjectives       TeamObjective[]          @relation("ObjectiveOwner")
  ownedKeyResults           TeamKeyResult[]          @relation("KeyResultOwner")
  keyResultAlignments       TeamKeyResultAlignment[]
  keyResultCheckIns         TeamKeyResultCheckIn[]
  sentTeamMessages          TeamMessage[]            @relation("TeamMessageSender")
  receivedTeamMessages      TeamMessageRecipient[]
  weeklyReports             TeamWeeklyReport[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
}

model Team {
  id               String             @id @default(cuid())
  name             String
  description      String?
  mission          String?
  responsibilities String?
  members          TeamMember[]
  projects         Project[]
  invites          TeamInvite[]
  objectives       TeamObjective[]
  messages         TeamMessage[]
  weeklyReports    TeamWeeklyReport[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model TeamMember {
  id             String   @id @default(cuid())
  teamId         String
  userId         String
  role           TeamRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  displayName    String?
  title          String?
  responsibility String?
  bio            String?
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamObjective {
  id          String          @id @default(cuid())
  teamId      String
  title       String
  description String          @default("")
  periodType  OkrPeriodType
  periodLabel String
  startsAt    DateTime
  endsAt      DateTime
  ownerId     String
  status      OkrStatus       @default(ACTIVE)
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner       User            @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  keyResults  TeamKeyResult[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([teamId, startsAt, endsAt])
}

model TeamKeyResult {
  id           String                   @id @default(cuid())
  objectiveId  String
  title        String
  targetValue  Float
  currentValue Float                    @default(0)
  unit         String
  confidence   Int                      @default(50)
  ownerId      String
  objective    TeamObjective            @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner        User                     @relation("KeyResultOwner", fields: [ownerId], references: [id])
  alignments   TeamKeyResultAlignment[]
  checkIns     TeamKeyResultCheckIn[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([objectiveId])
}

model TeamKeyResultAlignment {
  keyResultId String
  userId      String
  keyResult   TeamKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([keyResultId, userId])
  @@index([userId])
}

model TeamKeyResultCheckIn {
  id           String        @id @default(cuid())
  keyResultId  String
  authorId     String
  currentValue Float
  confidence   Int
  note         String        @default("")
  keyResult    TeamKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id])
  createdAt    DateTime      @default(now())

  @@index([keyResultId, createdAt])
}

model TeamMessage {
  id         String                 @id @default(cuid())
  teamId     String
  senderId   String
  title      String
  body       String
  priority   MessagePriority        @default(NORMAL)
  projectId  String?
  taskId     String?
  revokedAt  DateTime?
  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender     User                   @relation("TeamMessageSender", fields: [senderId], references: [id])
  recipients TeamMessageRecipient[]
  createdAt  DateTime               @default(now())

  @@index([teamId, createdAt])
}

model TeamMessageRecipient {
  messageId   String
  userId      String
  deliveredAt DateTime    @default(now())
  readAt      DateTime?
  message     TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, readAt, deliveredAt])
}

model TeamWeeklyReport {
  id          String             @id @default(cuid())
  teamId      String
  authorId    String
  weekStart   DateTime
  weekEnd     DateTime
  content     String
  status      WeeklyReportStatus @default(DRAFT)
  submittedAt DateTime?
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([teamId, authorId, weekStart])
  @@index([teamId, weekStart, status])
  @@index([authorId, weekStart])
}

model TeamInvite {
  id              String    @id @default(cuid())
  teamId          String
  createdById     String
  role            TeamRole  @default(MEMBER)
  prefix          String
  tokenHash       String    @unique
  tokenCiphertext String?
  expiresAt       DateTime
  maxUses         Int       @default(50)
  useCount        Int       @default(0)
  revokedAt       DateTime?
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("TeamInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([teamId, createdAt])
  @@index([createdById, createdAt])
}

model SmsCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  ip        String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

model Project {
  id             String              @id @default(cuid())
  teamId         String?
  code           String              @unique
  name           String
  description    String
  background     String              @default("")
  status         String              @default("ACTIVE")
  startDate      DateTime?
  endDate        DateTime?
  members        ProjectMember[]
  requirements   Requirement[]
  tasks          Task[]
  bugs           Bug[]
  versions       Version[]
  milestones     Milestone[]
  releases       Release[]
  files          FileAsset[]
  folders        FileFolder[]
  fileShares     FileShare[]
  fileUploads    FileUploadSession[]
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([teamId])
}

model ProjectMember {
  id             String      @id @default(cuid())
  projectId      String
  userId         String
  role           ProjectRole
  responsibility String?
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Requirement {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  projectId          String
  title              String
  description        String
  acceptanceCriteria String
  priority           Priority
  status             String
  targetVersionId    String?
  requesterId        String?
  closedAt           DateTime?
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetVersion      Version?                 @relation(fields: [targetVersionId], references: [id])
  requester          User?                    @relation("RequirementRequester", fields: [requesterId], references: [id])
  participants       RequirementParticipant[]
  tasks              Task[]
  bugs               Bug[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model RequirementParticipant {
  requirementId String
  userId        String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requirementId, userId])
  @@index([userId])
}

model Task {
  id                 String           @id @default(cuid())
  code               String           @unique
  projectId          String
  requirementId      String?
  versionId          String?
  title              String
  description        String
  acceptanceCriteria String
  priority           Priority
  status             TaskStatus       @default(TODO)
  dueAt              DateTime?
  closedAt           DateTime?
  completedAt        DateTime?
  assigneeId         String?
  coordinatorId      String?
  acceptorId         String?
  createdById        String?
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement        Requirement?     @relation(fields: [requirementId], references: [id])
  version            Version?         @relation(fields: [versionId], references: [id])
  assignee           User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  coordinator        User?            @relation("TaskCoordinator", fields: [coordinatorId], references: [id])
  acceptor           User?            @relation("TaskAcceptor", fields: [acceptorId], references: [id])
  createdBy          User?            @relation("TaskCreator", fields: [createdById], references: [id])
  dependencies       TaskDependency[] @relation("TaskDependencies")
  dependents         TaskDependency[] @relation("TaskDependents")
  reports            WorkReport[]
  acceptances        Acceptance[]
  bugs               Bug[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([createdById, status])
  @@index([projectId, completedAt])
  @@index([projectId, closedAt])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

model WorkReport {
  id              String   @id @default(cuid())
  taskId          String
  authorId        String
  summary         String
  completedItems  Json
  verification    String
  remainingIssues Json
  needsSupport    Json
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author          User     @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())
}

model Acceptance {
  id         String   @id @default(cuid())
  taskId     String
  reviewerId String
  result     String
  comment    String
  verification String @default("")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  createdAt  DateTime @default(now())
}

model Bug {
  id             String       @id @default(cuid())
  code           String       @unique
  projectId      String
  requirementId  String?
  taskId         String?
  foundVersionId String?
  fixedVersionId String?
  title          String
  description    String
  reproduceSteps String
  severity       Priority
  status         BugStatus    @default(NEW)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement? @relation(fields: [requirementId], references: [id])
  task           Task?        @relation(fields: [taskId], references: [id])
  foundVersion   Version?     @relation("FoundVersion", fields: [foundVersionId], references: [id])
  fixedVersion   Version?     @relation("FixedVersion", fields: [fixedVersionId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Version {
  id           String               @id @default(cuid())
  projectId    String
  name         String
  goal         String
  description  String               @default("")
  ownerId      String?
  status       VersionStatus        @default(PLANNING)
  plannedAt    DateTime?
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?                @relation("VersionOwner", fields: [ownerId], references: [id])
  participants VersionParticipant[]
  requirements Requirement[]
  tasks        Task[]
  foundBugs    Bug[]                @relation("FoundVersion")
  fixedBugs    Bug[]                @relation("FixedVersion")
  releases     Release[]
  milestones   Milestone[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([projectId, name])
}

model VersionParticipant {
  versionId String
  userId    String
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([versionId, userId])
  @@index([userId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  versionId   String?
  ownerId     String?
  title       String
  description String          @default("")
  status      MilestoneStatus @default(PLANNED)
  dueAt       DateTime
  completedAt DateTime?
  sortOrder   Int             @default(0)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Version?        @relation(fields: [versionId], references: [id], onDelete: SetNull)
  owner       User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, dueAt])
  @@index([ownerId])
}

model Release {
  id           String        @id @default(cuid())
  projectId    String
  versionId    String
  build        String
  environment  String
  notes        String
  rollbackPlan String
  status       ReleaseStatus @default(PLANNED)
  releasedAt   DateTime?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version      Version       @relation(fields: [versionId], references: [id])
  createdAt    DateTime      @default(now())
}

model FileFolder {
  id        String       @id @default(cuid())
  projectId String?
  parentId  String?
  name      String
  path      String
  sortOrder Int          @default(0)
  creatorId String
  deletedAt DateTime?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  FileFolder[] @relation("FolderTree")
  creator   User         @relation("FolderCreator", fields: [creatorId], references: [id])
  files     FileAsset[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, parentId, name])
  @@index([projectId, parentId, deletedAt])
}

model FileAsset {
  id               String         @id @default(cuid())
  projectId        String?
  folderId         String?
  creatorId        String?
  name             String
  mimeType         String
  size             BigInt
  storageKey       String?
  currentVersionId String?        @unique
  tags             String[]
  deletedAt        DateTime?
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder           FileFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator          User?          @relation("FileCreator", fields: [creatorId], references: [id])
  versions         FileVersion[]  @relation("FileVersions")
  currentVersion   FileVersion?   @relation("CurrentFileVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  links            ResourceLink[]
  shares           FileShare[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectId, folderId, deletedAt])
}

model FileVersion {
  id           String     @id @default(cuid())
  fileId       String
  version      Int
  objectKey    String     @unique
  originalName String
  mimeType     String
  size         BigInt
  sha256       String?
  uploaderId   String
  file         FileAsset  @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  currentFor   FileAsset? @relation("CurrentFileVersion")
  uploader     User       @relation("VersionUploader", fields: [uploaderId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([fileId, version])
  @@index([fileId, createdAt])
}

model FileUploadSession {
  id          String   @id @default(cuid())
  projectId   String?
  folderId    String?
  fileId      String?
  userId      String
  name        String
  mimeType    String
  size        BigInt
  objectKey   String   @unique
  multipartId String
  status      String   @default("PENDING")
  expiresAt   DateTime
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, expiresAt])
}

model FileShare {
  id           String    @id @default(cuid())
  projectId    String?
  fileId       String
  creatorId    String
  tokenHash    String    @unique
  codeHash     String?
  expiresAt    DateTime
  maxDownloads Int?
  downloads    Int       @default(0)
  revokedAt    DateTime?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file         FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  creator      User      @relation("ShareCreator", fields: [creatorId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([fileId, createdAt])
  @@index([projectId, revokedAt])
}

model ResourceLink {
  id           String    @id @default(cuid())
  fileId       String
  resourceType String
  resourceId   String
  file         FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
}

model ApiToken {
  id          String            @id @default(cuid())
  userId      String
  name        String
  prefix      String
  tokenHash   String            @unique
  permissions String[]
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyRecords ApiIdempotencyRecord[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, createdAt])
}

model ApiIdempotencyRecord {
  id          String   @id @default(cuid())
  tokenId     String
  userId      String
  key         String
  method      String
  path        String
  requestHash String
  status      Int
  response    Json
  expiresAt   DateTime
  token       ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([tokenId, key])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorType  String
  action     String
  resource   String
  resourceId String?
  channel    String
  metadata   Json?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Feedback {
  id          String               @id @default(cuid())
  userId      String
  type        String
  content     String
  status      String               @default("OPEN")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments FeedbackAttachment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model FeedbackAttachment {
  id         String   @id @default(cuid())
  feedbackId String
  name       String
  mimeType   String
  size       Int
  data       Bytes
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}
